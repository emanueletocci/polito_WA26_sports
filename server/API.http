# This file can be used for testing the API with the VS Code "REST Client" extension.
# NOTE: the extension keeps a cookie jar per file, so once you run a login request below,
# subsequent requests in this same file will automatically reuse the session cookie.

## Retrieve all free facilities (public, no login required).
GET http://localhost:3001/api/facilities HTTP/1.1
###

## Retrieve all equipment with availability (public, no login required).
GET http://localhost:3001/api/equipment HTTP/1.1
###


# Authentication

## Login with correct credentials (user2, 2FA enabled, 1 active reservation).
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Check current session (should return user info after the login above).
GET http://localhost:3001/api/sessions/current HTTP/1.1
###

## Second factor login (only works if the user above has TOTP enabled and a valid code is provided).
POST http://localhost:3001/api/login-totp HTTP/1.1
content-type: application/json

{
  "code": "123456"
}
###

## Logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# Reservations (require login - run the login request above first)

## Login as user3 (score -1, 1 active reservation) for the tests below.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user3@example.com",
  "password": "Password3!"
}
###

## Retrieve the logged-in user's active reservations, including equipment.
GET http://localhost:3001/api/reservations HTTP/1.1
###

## Create a new reservation with direct facility selection (tennis, exact mandatory minimum).
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T3",
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Create a new reservation with automatic facility assignment (no facilityCode given).
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 6,
  "equipment": [
    { "equipmentId": 13, "quantity": 1 },
    { "equipmentId": 14, "quantity": 1 }
  ]
}
###

## Modify a reservation's optional/extra equipment (adjust the id to one of your active reservations).
PUT http://localhost:3001/api/reservations/1 HTTP/1.1
content-type: application/json

{
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 },
    { "equipmentId": 3, "quantity": 1 }
  ]
}
###

## Delete a reservation (adjust the id to one of your active reservations).
DELETE http://localhost:3001/api/reservations/1 HTTP/1.1
###


# Wrong Requests

## Login with wrong password - should return 401.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "WrongPassword!"
}
###

## Access reservations without being logged in - should return 401.
# (Run this in a fresh session / after logout, otherwise the cookie jar keeps you logged in.)
GET http://localhost:3001/api/reservations HTTP/1.1
###

## Create a reservation without the mandatory minimum equipment - should return 422.
POST http://localhost:3001/api/reservations