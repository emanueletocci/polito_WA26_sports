# This file can be used for testing the API with the VS Code "REST Client" extension.
# Every scenario below is SELF-CONTAINED: it starts with its own login and ends with its
# own logout. Just click "Send Request" top to bottom within a scenario - no need to scroll
# up to find a previous login.
# NOTE: PUT /api/reservations/:id is currently commented out in index.mjs - not tested here yet.


# =============================================================================
# SCENARIO 0 - Public endpoints (no login needed)
# =============================================================================

## Retrieve all free facilities.
GET http://localhost:3001/api/facilities HTTP/1.1
###

## Retrieve all equipment with availability.
GET http://localhost:3001/api/equipment HTTP/1.1
###


# =============================================================================
# SCENARIO 1 - Basic login/logout flow with TOTP (user2)
# =============================================================================

## Step 1: login with correct credentials.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: check current session (should show the user info from the login above).
GET http://localhost:3001/api/sessions/current HTTP/1.1
###

## Step 3: second factor login (needs a valid, non-expired TOTP code for user2's secret).
POST http://localhost:3001/api/login-totp HTTP/1.1
content-type: application/json

{
  "code": "714651"
}
###

## Step 4: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# =============================================================================
# SCENARIO 2 - View another user's reservations (user4: score -2, 2 reservations)
# =============================================================================

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user4@example.com",
  "password": "Password4!"
}
###

## Step 2: retrieve active reservations, including rented equipment.
GET http://localhost:3001/api/reservations HTTP/1.1
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# =============================================================================
# SCENARIO 3 - Create a reservation with direct facility selection (user2)
# =============================================================================

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: create reservation on a specific facility (tennis, exact mandatory minimum).
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T2",
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# =============================================================================
# SCENARIO 4 - Create a reservation with automatic facility assignment (user2)
# =============================================================================

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: create reservation without specifying facilityCode (cycling, auto-assigned).
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 6,
  "equipment": [
    { "equipmentId": 13, "quantity": 1 },
    { "equipmentId": 14, "quantity": 1 }
  ]
}
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# =============================================================================
# SCENARIO 5 - Delete a reservation and verify its side effects (user2)
# =============================================================================

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: list reservations to find an id to delete (check the response for the id).
GET http://localhost:3001/api/reservations HTTP/1.1
###

## Step 3: delete the reservation (replace 1 with the id found above).
DELETE http://localhost:3001/api/reservations/7 HTTP/1.1
###

## Step 4: verify the score was decremented (should be one less than before Step 3).
GET http://localhost:3001/api/sessions/current HTTP/1.1
###

## Step 5: verify the released facility is free again.
GET http://localhost:3001/api/facilities HTTP/1.1
###

## Step 6: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# =============================================================================
# WRONG REQUESTS - each scenario below is also self-contained
# =============================================================================

# -----------------------------------------------------------------------------
# WR1 - Login with wrong password - should return 401.
# -----------------------------------------------------------------------------
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "WrongPassword!"
}
###


# -----------------------------------------------------------------------------
# WR2 - Access reservations without being logged in - should return 401.
# -----------------------------------------------------------------------------

## Step 1: make sure we are logged out first.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###

## Step 2: this must fail with 401.
GET http://localhost:3001/api/reservations HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR3 - Logging out when already logged out is a successful no-op - should return 200, not 401.
# -----------------------------------------------------------------------------
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR4 - Create a reservation without the mandatory minimum equipment - should return 422.
# -----------------------------------------------------------------------------

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: only 1 racket instead of the mandatory 2 - should fail.
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T3",
  "equipment": [
    { "equipmentId": 1, "quantity": 1 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR5 - Create a reservation on an already-booked facility - should return 422.
# -----------------------------------------------------------------------------

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: T1 is already booked (user2's own reservation from the seed) - should fail.
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T1",
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR6 - 30-second rebooking cooldown - should return 422 if retried too soon.
# Run Step 3 IMMEDIATELY after Step 2b (within 30 seconds) for the test to be meaningful.
# -----------------------------------------------------------------------------

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: book a tennis facility to trigger the cooldown once deleted.
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T3",
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 2b: delete it right away (replace the id with the one returned by Step 2).
DELETE http://localhost:3001/api/reservations/6 HTTP/1.1
###

## Step 3: try to book tennis again immediately - should fail with the cooldown error.
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T3",
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 4: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR7 - Delete a reservation that does not exist - should return 404.
# -----------------------------------------------------------------------------

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user2@example.com",
  "password": "Password2!"
}
###

## Step 2: this id does not exist - should fail with 404.
DELETE http://localhost:3001/api/reservations/9999 HTTP/1.1
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR8 - Delete a reservation belonging to another user - should return 404 (not 403,
# to avoid revealing that the reservation exists at all).
# -----------------------------------------------------------------------------

## Step 1: login as user3.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user3@example.com",
  "password": "Password3!"
}
###

## Step 2: reservation id 1 belongs to user2, not user3 - should fail with 404.
DELETE http://localhost:3001/api/reservations/1 HTTP/1.1
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR9 - Negative-score user (user3, score -1) requests MORE than the mandatory
# minimum - should return 422.
# -----------------------------------------------------------------------------

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user3@example.com",
  "password": "Password3!"
}
###

## Step 2: 3 rackets requested, but mandatory minimum is 2 - should fail (negative score).
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T3",
  "equipment": [
    { "equipmentId": 1, "quantity": 3 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###


# -----------------------------------------------------------------------------
# WR10 - Negative-score user (user3) requests EXACTLY the mandatory minimum -
# should succeed.
# -----------------------------------------------------------------------------

## Step 1: login.
POST http://localhost:3001/api/sessions HTTP/1.1
content-type: application/json

{
  "email": "user3@example.com",
  "password": "Password3!"
}
###

## Step 2: exactly the mandatory minimum - should succeed.
POST http://localhost:3001/api/reservations HTTP/1.1
content-type: application/json

{
  "facilityTypeId": 1,
  "facilityCode": "T3",
  "equipment": [
    { "equipmentId": 1, "quantity": 2 },
    { "equipmentId": 2, "quantity": 3 }
  ]
}
###

## Step 3: logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###
