classDiagram
    direction TB

    class main_jsx {
        StrictMode + BrowserRouter
        mounts App on the root div
    }

    class App_jsx {
        +App() PAGE_ROOT
        -LoginWithTotp() router
        state: loggedIn, loggedInTotp, user, message
        showSuccess(text)
        handleErrors(err)
        handleLogin(credentials)
        handleLogout()
        refreshUserInfo()
    }

    class Layout_jsx {
        +Layout() SHELL
        +NotFound() PAGE
        renders Navigation, message Alert, Outlet
    }

    class Navigation_jsx {
        +Navigation() REUSABLE
        props: loggedIn, user, loggedInTotp, logout
    }

    class Auth_jsx {
        +TotpForm() PAGE
        +LoginForm() PAGE
        +LogoutButton() REUSABLE
        +LoginButton() REUSABLE
        doTotpVerify()
    }

    class Home_jsx {
        +Home() PAGE
        state: facilityGroups, equipmentList
        state: waitingFacilities, waitingEquipment
        fetch: getFacilities, getEquipment
    }

    class FacilityCard_jsx {
        +FacilityCard() REUSABLE
        -getBadgeColor(free) helper
        props: group, equipmentRules
    }

    class EquipmentTable_jsx {
        +EquipmentTable() REUSABLE
        -EquipmentStockRow() private
        -getStockStatus(qty) helper
        props: equipmentList
    }

    class Reservations_jsx {
        +Reservations() PAGE
        -ReservationRow() private
        state: reservations, disabled, waiting
        fetch: getReservations, deleteReservation
        handleDelete(reservationId)
    }

    class ReservationEdit_jsx {
        +ReservationEdit() PAGE
        state: reservation, equipmentRules
        state: quantities, initialQuantities, waiting
        fetch: getReservation, getEquipment, updateReservation
        getEffectiveMin(equipment)
        getEffectiveMax(equipment)
        handleQuantityChange(equipment, delta)
        handleSubmit(event)
    }

    class Book_jsx {
        +Book() PAGE
        -buildInitialQuantities(rules) helper
        -findUnavailableMandatory(rules) helper
        state: facilityTypes, selectedTypeId, mode
        state: freeFacilities, selectedFacilityCode, quantities
        fetch: getFacilityTypes, getFacilities, getEquipment, createReservation
        handleQuantityChange(equipment, delta)
        handleSubmit(event)
    }

    class FacilitySelection_jsx {
        +FacilitySelection() REUSABLE
        props: facilityTypes, selectedTypeId, mode
        props: freeFacilities, selectedFacilityCode
    }

    class EquipmentSelection_jsx {
        +EquipmentSelection() REUSABLE
        props: equipmentRules, quantities, canRequestExtra
    }

    class EquipmentRow_jsx {
        +EquipmentRow() REUSABLE
        props: equipment, quantity
        props: canDecrease, canIncrease
    }

    class API_js {
        +API default export
        logIn, logOut, getUserInfo, totpVerify
        getFacilities, getFacilityTypes, getEquipment
        getReservations, getReservation
        createReservation, updateReservation, deleteReservation
    }

    class utils_js {
        +groupFacilitiesByType(facilities)
        +formatName(name)
    }

    main_jsx --> App_jsx : mounts

    App_jsx --> Layout_jsx : route /
    App_jsx --> Home_jsx : route index
    App_jsx --> Reservations_jsx : route /reservations
    App_jsx --> ReservationEdit_jsx : route reservations reservationId edit
    App_jsx --> Book_jsx : route /book
    App_jsx --> Auth_jsx : route /login

    Layout_jsx --> Navigation_jsx : renders
    Navigation_jsx --> Auth_jsx : LoginButton, LogoutButton

    Home_jsx --> FacilityCard_jsx : renders
    Home_jsx --> EquipmentTable_jsx : renders
    Reservations_jsx --> ReservationEdit_jsx : Link to edit
    ReservationEdit_jsx --> EquipmentRow_jsx : renders
    Book_jsx --> FacilitySelection_jsx : renders
    Book_jsx --> EquipmentSelection_jsx : renders
    EquipmentSelection_jsx --> EquipmentRow_jsx : renders

    App_jsx ..> API_js : uses
    Auth_jsx ..> API_js : uses
    Home_jsx ..> API_js : uses
    Reservations_jsx ..> API_js : uses
    ReservationEdit_jsx ..> API_js : uses
    Book_jsx ..> API_js : uses

    Home_jsx ..> utils_js : groupFacilitiesByType, formatName
    FacilityCard_jsx ..> utils_js : formatName
    EquipmentTable_jsx ..> utils_js : formatName
    EquipmentRow_jsx ..> utils_js : formatName
    Reservations_jsx ..> utils_js : formatName
    ReservationEdit_jsx ..> utils_js : formatName
    Book_jsx ..> utils_js : formatName
    FacilitySelection_jsx ..> utils_js : formatName